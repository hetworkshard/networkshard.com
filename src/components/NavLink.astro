---
interface Props {
  href: string;
  /** mobile variant uses block padding + md:hidden container styling */
  mobile?: boolean;
}

const { href, mobile = false } = Astro.props;
const currentPath = Astro.url.pathname;
const active = href === '/' ? currentPath === '/' : currentPath.startsWith(href);

const base = mobile
  ? 'block border-b border-border px-1 py-3.5 text-xs uppercase tracking-[0.14em] transition-colors'
  : 'block border-b border-border py-2.5 text-xs uppercase tracking-[0.14em] transition-colors';
const state = active
  ? 'text-foreground font-semibold'
  : 'text-muted-foreground hover:text-foreground';
---

<a href={href} data-nav-link class:list={[base, state]} aria-current={active ? 'page' : undefined}>
  <slot />
</a>
