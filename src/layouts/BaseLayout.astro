---
import '../styles/global.css';
import NavLink from '../components/NavLink.astro';
import { breadcrumbSchema } from '../lib/jsonld';

type JsonLd = Record<string, unknown>;

interface Props {
  title: string;
  description?: string;
  image?: string;
  ogType?: string;
  jsonLd?: JsonLd | JsonLd[];
}

const { title, description = "Het Patel — Cybersecurity Engineer specializing in penetration testing, VAPT, vulnerability assessment, and security research.", image, ogType = 'website', jsonLd } = Astro.props;
const currentPath = Astro.url.pathname;
const buildCommit =
  import.meta.env.PUBLIC_COMMIT_SHA?.slice(0, 7) ||
  import.meta.env.GITHUB_SHA?.slice(0, 7) ||
  'dev';

const pathSegments = currentPath
  .split('/')
  .filter(Boolean)
  .map((s) => decodeURIComponent(s));

const breadcrumbs = [
  { label: 'Home', href: '/' },
  ...pathSegments.map((seg, i) => ({
    label: seg.replace(/-/g, ' '),
    href: '/' + pathSegments.slice(0, i + 1).map((s) => encodeURIComponent(s)).join('/'),
  })),
];

// Collect all JSON-LD blocks: caller-provided (object or array) + an
// auto-generated BreadcrumbList for any non-home page.
const providedLd: JsonLd[] = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
const crumbLd = breadcrumbSchema(breadcrumbs);
const jsonLdBlocks: JsonLd[] = [...providedLd, ...(crumbLd ? [crumbLd] : [])];
---

<!DOCTYPE html>
<html class="bg-background text-foreground" lang="en-US">
<head>
  <meta charset="utf-8" />
  <meta name="theme-color" content="#fffcf0" />
  <script is:inline>
    (function () {
      const theme =
        localStorage.getItem('theme') ||
        (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
      document.documentElement.setAttribute('data-theme', theme);
      // Keep the mobile browser chrome (address bar) matching the active theme.
      document
        .querySelector('meta[name="theme-color"]')
        ?.setAttribute('content', theme === 'dark' ? '#171816' : '#fffcf0');
    })();
  </script>
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <meta name="description" content={description} />
  <meta name="keywords" content="cybersecurity, penetration testing, VAPT, vulnerability assessment, security research, ethical hacking, red teaming, Het Patel, networkshard" />
  <meta name="author" content="Het Patel" />
  <meta property="og:title" content={`${title} | networkshard`} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content={ogType} />
  <meta property="og:url" content={Astro.url.href} />
  {image && <meta property="og:image" content={image} />}
  {image && <meta property="og:image:width" content="1200" />}
  {image && <meta property="og:image:height" content="630" />}
  <meta name="twitter:card" content={image ? "summary_large_image" : "summary"} />
  <meta name="twitter:title" content={`${title} | networkshard`} />
  <meta name="twitter:description" content={description} />
  {image && <meta name="twitter:image" content={image} />}
  <link rel="icon" href="/favicon.ico" sizes="16x16" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="canonical" href={Astro.url.href} />
  <link rel="sitemap" href="/sitemap-index.xml" />
  <link rel="llms" type="text/plain" href="/llms.txt" />
  <link rel="preload" href="/fonts/GeistMonoVF.woff2" as="font" type="font/woff2" crossorigin />
  <title>{title} — networkshard</title>
  {jsonLdBlocks.map((block) => (
    <script is:inline type="application/ld+json" set:html={JSON.stringify(block)} />
  ))}
</head>
<body class="font-mono">

  <a href="#main-content" class="skip-link">Skip to content</a>

  <!-- Desktop masthead / mobile top bar -->
  <header class="site-header">
    <div class="site-header__inner">
      <a href="/" class="site-mark" aria-label="networkshard home">
        <span>network</span><span>shard</span>
      </a>

      <nav class="site-nav" aria-label="Primary navigation">
        <NavLink href="/blog">Blog</NavLink>
        <NavLink href="/projects">Projects</NavLink>
        <NavLink href="/about">About</NavLink>
      </nav>

      <div class="site-tools">
        <button
          type="button"
          class="square-control"
          title="Search (Ctrl+K)"
          aria-label="Search"
          aria-haspopup="dialog"
          aria-controls="search-dialog"
        >
          <svg class="size-4" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square" stroke-linejoin="miter" aria-hidden="true"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
        </button>

        <button id="theme-toggle" class="square-control" aria-label="Toggle theme">
          <svg class="icon-sun size-4" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square" stroke-linejoin="miter"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
          <svg class="icon-moon size-4" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square" stroke-linejoin="miter"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
        </button>

        <button
          id="mobile-menu-toggle"
          type="button"
          class="square-control mobile-menu-button"
          aria-label="Open menu"
          aria-expanded="false"
          aria-controls="mobile-menu"
        >
          <svg class="mobile-menu-open size-4" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
          <svg class="mobile-menu-close size-4 hidden" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
        </button>
      </div>
    </div>

    <nav id="mobile-menu" class="mobile-menu hidden" aria-label="Mobile navigation">
      <NavLink href="/blog" mobile>Blog</NavLink>
      <NavLink href="/projects" mobile>Projects</NavLink>
      <NavLink href="/about" mobile>About</NavLink>
    </nav>
  </header>

  <div id="search-dialog" class="search-dialog fixed inset-0 z-[60] hidden items-start justify-center" role="dialog" aria-modal="true" aria-label="Search articles">
    <div class="relative z-10 w-[600px] max-w-[calc(100vw-2rem)] pt-16 md:pt-24">
      <div class="search-dialog__box relative">
        <div class="relative">
          <svg class="size-4 text-muted-foreground absolute left-4 top-1/2 -translate-y-1/2 pointer-events-none" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
          <input
            id="search-input"
            placeholder="Search the archive"
            class="w-full h-12 pl-12 pr-12 bg-transparent border-0 text-sm outline-none placeholder:text-muted-foreground"
            aria-label="Search articles"
            type="text"
          />
          <button type="button" class="square-control absolute right-1.5 top-1/2 -translate-y-1/2" aria-label="Close search" data-search-close>
            <svg class="size-4" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
          </button>
        </div>
      </div>

      <div id="search-results" class="search-dialog__box relative z-10 mt-2 max-h-[60vh] overflow-y-auto">
        <div class="p-4 text-xs text-muted-foreground">Start typing to search posts.</div>
      </div>
    </div>
  </div>

  <!-- Main -->
  <main id="main-content">
    <nav aria-label="Breadcrumb" class="breadcrumbs">
      <ol role="list" data-slot="breadcrumb-list">
        {breadcrumbs.map((c, idx) => {
          const isLast = idx === breadcrumbs.length - 1;
          return (
            <li>
              {idx !== 0 && <span aria-hidden="true">/</span>}
              {isLast ? <span aria-current="page">{c.label}</span> : <a href={c.href}>{c.label}</a>}
            </li>
          );
        })}
      </ol>
    </nav>
    <slot />
  </main>

  <!-- Footer -->
  <footer class="site-footer">
    <div class="site-footer__inner">
      <span>&copy; {new Date().getFullYear()} Het Patel</span>
      <nav aria-label="Footer links">
        <a href="/categories/">Categories</a>
        <a href="/blog/tags">Tags</a>
        <a href="mailto:awesomehet1@gmail.com">Email</a>
      </nav>
      <span class="site-footer__build">build/{buildCommit}</span>
    </div>
  </footer>

  <!-- Theme toggle script -->
  <script is:inline>
    document.getElementById('theme-toggle')?.addEventListener('click', () => {
      const html = document.documentElement;
      const next = html.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
      html.setAttribute('data-theme', next);
      localStorage.setItem('theme', next);
      document
        .querySelector('meta[name="theme-color"]')
        ?.setAttribute('content', next === 'dark' ? '#171816' : '#fffcf0');
    });
  </script>

  <!-- Mobile menu toggle -->
  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const toggle = document.getElementById('mobile-menu-toggle');
      const menu = document.getElementById('mobile-menu');
      const iconOpen = toggle?.querySelector('.mobile-menu-open');
      const iconClose = toggle?.querySelector('.mobile-menu-close');
      if (!toggle || !menu) return;

      function closeMenu() {
        menu.classList.add('hidden');
        iconOpen?.classList.remove('hidden');
        iconClose?.classList.add('hidden');
        toggle.setAttribute('aria-expanded', 'false');
        toggle.setAttribute('aria-label', 'Open menu');
      }

      function openMenu() {
        menu.classList.remove('hidden');
        iconOpen?.classList.add('hidden');
        iconClose?.classList.remove('hidden');
        toggle.setAttribute('aria-expanded', 'true');
        toggle.setAttribute('aria-label', 'Close menu');
      }

      toggle.addEventListener('click', () => {
        if (menu.classList.contains('hidden')) openMenu();
        else closeMenu();
      });

      // Close when a nav link is followed.
      menu.querySelectorAll('[data-nav-link]').forEach((link) => {
        link.addEventListener('click', closeMenu);
      });

      // Close when the viewport grows to the desktop breakpoint.
      window.matchMedia('(min-width: 768px)').addEventListener('change', (e) => {
        if (e.matches) closeMenu();
      });
    });
  </script>

  <!-- Blog search dialog script -->
  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const searchButton = document.querySelector('[aria-controls="search-dialog"]');
      const dialog = document.getElementById('search-dialog');
      const input = document.getElementById('search-input');
      const results = document.getElementById('search-results');
      let posts = [];
      let loaded = false;

      async function loadPosts() {
        if (loaded) return;
        try {
          const res = await fetch('/blog/search.json');
          if (!res.ok) return;
          posts = await res.json();
          loaded = true;
        } catch {
          // ignore
        }
      }

      function render(query) {
        if (!results) return;
        const q = (query || '').toLowerCase().trim();
        const filtered = !q
          ? posts.slice(0, 4)
          : posts.filter((p) =>
              (p.title && p.title.toLowerCase().includes(q)) ||
              (p.description && p.description.toLowerCase().includes(q))
            ).slice(0, 20);

        if (!filtered.length) {
          results.innerHTML = '<div class="p-4 text-xs text-muted-foreground">No matches found.</div>';
          return;
        }

        const heading = q ? 'Results' : 'Recent posts';
        const items = filtered.map((p) => {
          if (!q) {
            return `
              <a href="/blog/${p.slug}" class="block px-4 py-3 hover:bg-muted/60 transition-colors">
                <h3 class="blog-card-title font-mono text-sm font-semibold leading-snug text-foreground/90">${p.title}</h3>
              </a>
            `;
          }

          const date = p.date ? new Date(p.date).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' }) : '';
          return `
            <a href="/blog/${p.slug}" class="block px-4 py-3 hover:bg-muted/60 transition-colors">
              <div class="flex flex-col gap-1">
                <h3 class="blog-card-title font-mono text-sm font-semibold leading-snug text-foreground/90">${p.title}</h3>
                ${p.description ? `<p class="font-mono text-[11px] leading-relaxed text-muted-foreground line-clamp-2">${p.description}</p>` : ''}
                <div class="flex flex-wrap items-center gap-1.5 text-[10px] font-mono text-muted-foreground/80">
                  ${date ? `<time>${date}</time>` : ''}
                  ${p.readTime ? `<span>&middot;</span><span>${p.readTime}</span>` : ''}
                </div>
              </div>
            </a>
          `;
        }).join('');

        results.innerHTML = `
          <div class="p-3 border-b border-border/60 text-[11px] font-mono uppercase tracking-wider text-muted-foreground">${heading}</div>
          <div class="py-1">${items}</div>
        `;
      }

      let lastFocused = null;

      function isOpen() {
        return dialog && !dialog.classList.contains('hidden');
      }

      function openDialog() {
        if (!dialog || isOpen()) return;
        lastFocused = document.activeElement;
        dialog.classList.remove('hidden');
        dialog.classList.add('flex');
        document.body.style.overflow = 'hidden';
        loadPosts().then(() => {
          render('');
          if (input) {
            input.value = '';
            setTimeout(() => input.focus(), 10);
          }
        });
      }

      function closeDialog() {
        if (!dialog || !isOpen()) return;
        dialog.classList.add('hidden');
        dialog.classList.remove('flex');
        document.body.style.overflow = '';
        if (lastFocused && typeof lastFocused.focus === 'function') {
          lastFocused.focus();
        }
      }

      searchButton?.addEventListener('click', (e) => {
        e.preventDefault();
        openDialog();
      });

      dialog?.addEventListener('click', (e) => {
        if (e.target === dialog) closeDialog();
      });

      dialog?.querySelector('[data-search-close]')?.addEventListener('click', (e) => {
        e.preventDefault();
        closeDialog();
      });

      input?.addEventListener('input', (e) => {
        const target = e.target;
        render(target && 'value' in target ? target.value : '');
      });

      // Keep Tab focus inside the dialog while it is open.
      dialog?.addEventListener('keydown', (e) => {
        if (e.key !== 'Tab') return;
        const focusable = dialog.querySelectorAll(
          'a[href], button:not([disabled]), input, [tabindex]:not([tabindex="-1"])'
        );
        const visible = Array.prototype.filter.call(
          focusable,
          (el) => el.offsetParent !== null
        );
        if (!visible.length) return;
        const first = visible[0];
        const last = visible[visible.length - 1];
        if (e.shiftKey && document.activeElement === first) {
          e.preventDefault();
          last.focus();
        } else if (!e.shiftKey && document.activeElement === last) {
          e.preventDefault();
          first.focus();
        }
      });

      document.addEventListener('keydown', (e) => {
        if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'k') {
          e.preventDefault();
          openDialog();
        } else if (e.key === 'Escape' && isOpen()) {
          closeDialog();
        }
      });
    });
  </script>

  {currentPath.startsWith('/blog/') && (
    <>
      <!-- Copy button on code blocks (blog pages only) -->
      <script is:inline>
        document.addEventListener('DOMContentLoaded', () => {
          document.querySelectorAll('.prose pre').forEach(pre => {
            const wrapper = document.createElement('div');
            wrapper.className = 'code-block-wrapper';
            pre.parentNode.insertBefore(wrapper, pre);
            wrapper.appendChild(pre);

            const btn = document.createElement('button');
            btn.className = 'copy-btn';
            btn.setAttribute('aria-label', 'Copy code');
            btn.innerHTML = '<svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>';
            wrapper.appendChild(btn);

            btn.addEventListener('click', () => {
              const code = pre.querySelector('code')?.textContent || pre.textContent;
              navigator.clipboard.writeText(code).then(() => {
                btn.innerHTML = '<svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>';
                btn.classList.add('copied');
                setTimeout(() => {
                  btn.innerHTML = '<svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>';
                  btn.classList.remove('copied');
                }, 2000);
              });
            });
          });
        });
      </script>
    </>
  )}

  {currentPath === '/' && (
    <>
      <!-- Text scramble (home page only) -->
      <script is:inline>
        document.addEventListener('DOMContentLoaded', () => {
          if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
          const chars = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789#$!-_+';
          const duration = 700, interval = 40, baseDelay = 200, stagger = 160;
          function scramble(el, delay) {
            const original = el.textContent || '';
            const iterations = Math.round(duration / interval);
            let count = 0;
            setTimeout(() => {
              const timer = setInterval(() => {
                const revealed = Math.floor(count / iterations * original.length);
                el.textContent = original.split('').map((ch, i) =>
                  ch === ' ' || ch === '.' || i < revealed
                    ? ch : chars[Math.floor(Math.random() * chars.length)]
                ).join('');
                count++;
                if (count > iterations) { el.textContent = original; clearInterval(timer); }
              }, interval);
            }, delay);
          }
          document.querySelectorAll('.identity-title .identity-title__line').forEach((el, i) => {
            scramble(el, baseDelay + i * stagger);
          });
        });
      </script>
    </>
  )}
</body>
</html>

<style>
  [data-theme="dark"] .icon-sun { display: none; }
  [data-theme="light"] .icon-moon { display: none; }
  :root .icon-moon { display: none; }
  [data-theme="dark"] .icon-moon { display: block; }
  [data-theme="dark"] .icon-sun { display: none; }
  :root .icon-sun { display: block; }
</style>
