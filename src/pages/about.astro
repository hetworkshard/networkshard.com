---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { personSchema } from '../lib/jsonld';
import { getPublishedPosts } from '../lib/posts';

const ogImage = `${Astro.site}og/about.png`;

const posts = await getPublishedPosts();
const postCount = posts.length;

const skills = [
  'Penetration Testing', 'VAPT', 'Red Teaming', 'Vulnerability Assessment',
  'Security Research', 'Ethical Hacking', 'Burp Suite', 'Nmap', 'Metasploit',
  'Kali Linux', 'Wireshark', 'Python', 'Docker', 'Bash', 'Linux'
];

type ResearchAdvisory = {
  id: `CVE-${number}-${number}`;
  score: `${number}/10`;
  title: string;
  vendor: string;
  impact: string;
  href: `https://${string}`;
};

const researchAdvisories: ResearchAdvisory[] = [
  {
    id: 'CVE-2026-35478',
    score: '8.3/10',
    title: 'Arbitrary API Token Creation',
    vendor: 'InvenTree Security Advisory',
    impact: 'Any authenticated InvenTree user can create a valid API token attributed to any other user in the system — including administrators and superusers — by supplying the target\'s user ID in the user field of a POST /api/user/tokens/ request. The returned token is immediately usable for full API authentication as the target user, from any network location, with no further interaction required.',
    href: 'https://github.com/inventree/InvenTree/security/advisories/GHSA-qh5j-c28q-c4rg',
  },
  {
    id: 'CVE-2026-41234',
    score: '7.6/10',
    title: 'BIND Zone File Injection via TXT Record',
    vendor: 'Froxlor Security Advisory',
    impact: 'The DomainZones.add API endpoint fails to sanitize newline characters in TXT record content, so an authenticated customer with DNS editing enabled can break out of the record line in generated BIND zone files. This allows injecting arbitrary BIND directives and DNS records — including $INCLUDE to read world-readable files, spoofed A/MX/CNAME records for subdomain takeover or email interception, and malformed content that takes the zone offline.',
    href: 'https://github.com/froxlor/froxlor/security/advisories/GHSA-37m5-m4q3-fc6x',
  },
  {
    id: 'CVE-2026-52793',
    score: '8.1/10',
    title: 'API Authentication Bypasses 2FA',
    vendor: 'Froxlor Security Advisory',
    impact: 'Froxlor\'s API authentication (FroxlorRPC::validateAuth) does not enforce Two-Factor Authentication. When a user enables 2FA, the web UI correctly requires a TOTP code — but the API accepts requests authenticated with only an API key and secret, issuing no TOTP challenge. An attacker who obtains a leaked API key+secret for a 2FA-protected account has full access to all API operations without providing a second factor.',
    href: 'https://github.com/froxlor/froxlor/security/advisories/GHSA-f9rx-7wf7-jr36',
  },
];
---

<BaseLayout
  title="About Het Patel — Cybersecurity Engineer"
  description="About Het Patel — Cybersecurity Engineer specializing in penetration testing, VAPT, vulnerability assessment, and security research at Inventyv."
  image={ogImage}
  jsonLd={personSchema()}
>
  <section class="border-b border-border pb-8 md:pb-10">
    <div>
      <div class="flex flex-col gap-5">
        <div class="flex items-start gap-4">
          <img
            src="/me.webp"
            alt="Het Patel — Cybersecurity Engineer"
            width="765"
            height="1024"
            class="h-28 w-24 shrink-0 rounded-md border border-border object-cover object-[center_30%] grayscale transition-[filter,border-color,box-shadow] duration-300 ease-out hover:border-primary/60 hover:grayscale-0 hover:shadow-sm md:h-40 md:w-32"
            loading="eager"
            decoding="async"
          />
          <div class="min-w-0">
            <h1 class="text-2xl md:text-4xl font-bold text-foreground">Het Patel</h1>
            <p class="text-sm text-muted-foreground mt-1">@networkshard</p>
            <p class="text-sm text-muted-foreground mt-1">India</p>
            <p class="text-sm text-muted-foreground">Inventyv Software Services Pvt. Ltd.</p>
          </div>
        </div>

        <div class="space-y-4">
          <p class="text-base text-muted-foreground leading-relaxed">
            I'm a Junior Cybersecurity Engineer working across penetration testing, vulnerability validation, security research, and defensive engineering. I care about findings that can be reproduced, systems that can be inspected, and remediation that holds up in practice.
          </p>
          <p class="text-base text-muted-foreground leading-relaxed">
            My work is Linux-first and hands-on: I test web applications and infrastructure, review evidence closely, and turn repeated security workflows into understandable tools.
          </p>
        </div>

        <div class="border-y border-border py-4">
          <p class="mb-3 text-xs font-semibold uppercase tracking-[0.16em] text-muted-foreground">Skills & Tools</p>
          <p class="text-xs leading-6 text-muted-foreground">{skills.join(' · ')}</p>
        </div>

        <div class="flex flex-wrap items-center gap-6 text-sm">
          <a href="https://github.com/hett-patell" target="_blank" rel="noopener noreferrer" class="font-semibold text-foreground underline decoration-border underline-offset-4 transition-colors hover:decoration-primary">GitHub ↗</a>
          <a href="/Het Patel.pdf" download class="font-semibold text-foreground underline decoration-border underline-offset-4 transition-colors hover:decoration-primary">Download CV ↓</a>
        </div>
      </div>
    </div>
  </section>

  <!-- How I work -->
  <section class="pb-8 md:pb-12">
    <h2 class="text-xs font-mono font-semibold text-muted-foreground uppercase tracking-wider mb-4">How I work</h2>
    <div class="space-y-4 border-t border-border py-5 text-sm leading-relaxed text-muted-foreground">
      <p>
        I prefer to learn from observable behaviour: reproduce the issue, preserve the evidence, test the boundary conditions, and make the result useful to the people responsible for fixing it. When a workflow repeats, I look for a way to make it safer and easier to inspect.
      </p>
      <p>
        That approach runs through my <a href="/projects" class="font-semibold text-foreground underline decoration-border underline-offset-4 transition-colors hover:decoration-primary">Shard projects</a>. In my writing, I also document the operational lessons behind the tools—including <a href="/blog/deploy-your-own-ssh-honeypot" class="font-semibold text-foreground underline decoration-border underline-offset-4 transition-colors hover:decoration-primary">deploying an SSH honeypot</a> and <a href="/blog/shardlure-the-dashboard-was-lying" class="font-semibold text-foreground underline decoration-border underline-offset-4 transition-colors hover:decoration-primary">checking a dashboard against its underlying data</a>.
      </p>
    </div>
  </section>

  <!-- Experience -->
  <section class="pb-8 md:pb-12">
    <h2 class="text-xs font-mono font-semibold text-muted-foreground uppercase tracking-wider mb-4">Experience</h2>
    <p class="mb-5 text-sm leading-relaxed text-muted-foreground">
      In my professional work, I apply that same emphasis on verification, clear reporting, and practical remediation across production infrastructure and security assessments.
    </p>
    <div class="grid grid-cols-1">
      <div class="border-t border-border py-5">
        <div class="flex flex-wrap items-start justify-between gap-2">
          <div class="min-w-0">
            <p class="text-base font-bold text-foreground">Inventyv Software Services Pvt. Ltd.</p>
            <p class="text-sm text-muted-foreground mt-0.5">Junior Cybersecurity Engineer</p>
          </div>
          <div class="text-right shrink-0">
            <p class="text-xs font-mono text-muted-foreground">Dec 2025 — Present</p>
            <p class="text-xs font-mono text-muted-foreground mt-0.5">Ahmedabad, Gujarat</p>
          </div>
        </div>
        <ul class="mt-3 space-y-1.5 text-sm text-muted-foreground leading-relaxed list-disc pl-5 marker:text-primary/60">
          <li>Monitor live logs and firewall rules across production infrastructure.</li>
          <li>Audit all internal products for vulnerabilities and enforce security quality standards.</li>
          <li>Collaborated with development teams to remediate vulnerabilities and improve secure coding practices.</li>
          <li>Participated in internal security assessments and knowledge-sharing sessions.</li>
        </ul>
      </div>

      <div class="border-t border-border py-5">
        <div class="flex flex-wrap items-start justify-between gap-2">
          <div class="min-w-0">
            <p class="text-base font-bold text-foreground">Hacker4Help</p>
            <p class="text-sm text-muted-foreground mt-0.5">VAPT &amp; Cybersecurity Researcher — Intern</p>
          </div>
          <div class="text-right shrink-0">
            <p class="text-xs font-mono text-muted-foreground">Apr 2025 — Jun 2025</p>
            <p class="text-xs font-mono text-muted-foreground mt-0.5">Anand, Gujarat</p>
          </div>
        </div>
        <ul class="mt-3 space-y-1.5 text-sm text-muted-foreground leading-relaxed list-disc pl-5 marker:text-primary/60">
          <li>Performed Vulnerability Assessment and Penetration Testing across 25+ websites and reported findings to stakeholders.</li>
          <li>Researched emerging security threats and gained hands-on experience with automated VAPT tooling.</li>
          <li>Assisted with content delivery, training material, and learner support.</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- Hall of Fame -->
  <section class="pb-8 md:pb-12">
    <h2 class="text-xs font-mono font-semibold text-muted-foreground uppercase tracking-wider mb-4">Hall of Fame</h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 sm:gap-x-8">
      <div class="border-t border-border py-5">
        <p class="text-lg font-bold text-foreground">NASA</p>
        <p class="text-sm text-muted-foreground mt-0.5">Vulnerability Disclosure Policy (VDP)</p>
        <p class="text-sm text-muted-foreground mt-1">Letter of Recognition — May 2026</p>
        <a href="/NASA-LOR.pdf" target="_blank" rel="noopener noreferrer"
          class="inline-block mt-2 text-xs font-mono text-primary-hover hover:text-primary transition-colors">
          View letter &rarr;
        </a>
      </div>
      <div class="border-t border-border py-5">
        <p class="text-lg font-bold text-foreground">CERT-IN</p>
        <p class="text-sm text-muted-foreground mt-0.5">Indian Computer Emergency Response Team</p>
        <p class="text-sm text-muted-foreground mt-1">Hall of Fame — September & October 2025</p>
        <a href="https://www.cert-in.org.in/Hallof_Fame_Oct25.jsp" target="_blank" rel="noopener noreferrer"
          class="inline-block mt-2 text-xs font-mono text-primary-hover hover:text-primary transition-colors">
          View on CERT-IN &rarr;
        </a>
      </div>
      <div class="border-t border-border py-5">
        <p class="text-lg font-bold text-foreground">Zyte</p>
        <p class="text-sm text-muted-foreground mt-0.5">Responsible Disclosure Program</p>
        <p class="text-sm text-muted-foreground mt-1">Security Researcher — Hall of Fame</p>
        <a href="https://www.zyte.com/terms-policies/responsible-disclosure-policy/" target="_blank" rel="noopener noreferrer"
          class="inline-block mt-2 text-xs font-mono text-primary-hover hover:text-primary transition-colors">
          View on Zyte &rarr;
        </a>
      </div>
    </div>
  </section>

  <!-- CVEs -->
  <section class="pb-8 md:pb-12">
    <h2 class="text-xs font-mono font-semibold text-muted-foreground uppercase tracking-wider mb-4">CVEs</h2>
    <p class="mb-5 text-sm leading-relaxed text-muted-foreground">
      My security research includes work associated with the published advisories below. I present each issue in the scope documented by the vendor advisory, without implying that publication is a sole-discovery claim.
    </p>
    <div>
      {researchAdvisories.map((advisory) => (
        <article class="grid gap-4 border-t border-border py-5 sm:grid-cols-[8.5rem_minmax(0,1fr)] sm:gap-6">
          <dl class="grid grid-cols-2 gap-4 sm:block">
            <div>
              <dt class="text-[10px] font-mono font-semibold uppercase tracking-wider text-muted-foreground">CVE ID</dt>
              <dd class="mt-1 text-xs font-mono text-foreground sm:text-sm">{advisory.id}</dd>
            </div>
            <div class="sm:mt-4">
              <dt class="text-[10px] font-mono font-semibold uppercase tracking-wider text-muted-foreground">Score</dt>
              <dd class="mt-1 text-xs font-mono text-foreground sm:text-sm">{advisory.score}</dd>
            </div>
          </dl>
          <div class="min-w-0">
            <h3 class="text-base font-bold leading-snug text-foreground">{advisory.title}</h3>
            <p class="mt-0.5 text-xs text-muted-foreground">{advisory.vendor}</p>
            <p class="mt-3 text-sm leading-relaxed text-muted-foreground">{advisory.impact}</p>
            <a
              href={advisory.href}
              target="_blank"
              rel="noopener noreferrer"
              class="mt-3 inline-block text-xs font-mono text-primary-hover transition-colors hover:text-primary"
            >
              View advisory on GitHub &rarr;
            </a>
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- Certifications -->
  <section class="pb-8 md:pb-12">
    <h2 class="text-xs font-mono font-semibold text-muted-foreground uppercase tracking-wider mb-4">Certifications</h2>
    <div class="border-t border-border py-5">
      <div class="flex justify-between items-center">
        <div>
          <p class="text-base font-bold text-foreground">CRTA</p>
          <p class="text-sm text-muted-foreground">Certified Red Team Analyst</p>
        </div>
        <span class="text-sm font-mono text-muted-foreground">Cyberwarfare</span>
      </div>
    </div>
  </section>

  <!-- Writing -->
  <section class="pb-8 md:pb-12">
    <h2 class="text-xs font-mono font-semibold text-muted-foreground uppercase tracking-wider mb-4">Writing here</h2>
    <p class="mb-5 text-sm leading-relaxed text-muted-foreground">
      I use this site to write through security research, tooling, and lessons from running systems in the open. The archive is small by design and grows when I have evidence or a process worth sharing.
    </p>
    <div class="grid grid-cols-2 sm:grid-cols-3 sm:gap-x-8">
      <div class="border-t border-border py-5">
        <span class="text-xs font-mono font-semibold uppercase tracking-wider text-muted-foreground">Page views</span>
        <p class="mt-2 text-2xl font-bold text-foreground" id="pageviews">—</p>
      </div>
      <div class="border-t border-border py-5">
        <span class="text-xs font-mono font-semibold uppercase tracking-wider text-muted-foreground">Blog Posts</span>
        <p class="mt-2 text-2xl font-bold text-foreground">{postCount}</p>
      </div>
      <div class="border-t border-border py-5 col-span-2 sm:col-span-1">
        <span class="text-xs font-mono font-semibold uppercase tracking-wider text-muted-foreground">Since</span>
        <p class="mt-2 text-2xl font-bold text-foreground">2025</p>
      </div>
    </div>
  </section>

  <!-- Connect -->
  <section class="pb-8 md:pb-12">
    <h2 class="text-xs font-mono font-semibold text-muted-foreground uppercase tracking-wider mb-4">Connect</h2>
    <p class="mb-5 text-sm leading-relaxed text-muted-foreground">
      If you'd like to discuss security research, an assessment, or one of my projects, send me an email or reach out through any of the links below.
    </p>
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 md:gap-x-8">
      <a href="https://github.com/hett-patell" target="_blank" rel="noopener noreferrer" class="group block border-t border-border py-4">
        <div class="flex items-center gap-2 mb-1">
          <Icon name="github" class="size-4 text-muted-foreground" />
          <span class="text-sm font-semibold text-foreground">GitHub</span>
        </div>
        <span class="text-xs font-mono text-muted-foreground group-hover:text-primary transition-colors">@networkshard</span>
      </a>

      <a href="https://www.linkedin.com/in/hetpatel9/" target="_blank" rel="noopener noreferrer" class="group block border-t border-border py-4">
        <div class="flex items-center gap-2 mb-1">
          <Icon name="linkedin" class="size-4 text-muted-foreground" />
          <span class="text-sm font-semibold text-foreground">LinkedIn</span>
        </div>
        <span class="text-xs font-mono text-muted-foreground group-hover:text-primary transition-colors">hetpatel9</span>
      </a>

      <a href="https://tryhackme.com/p/hettt" target="_blank" rel="noopener noreferrer" class="group block border-t border-border py-4">
        <div class="flex items-center gap-2 mb-1">
          <span class="text-xs font-bold font-mono text-muted-foreground">THM</span>
          <span class="text-sm font-semibold text-foreground">TryHackMe</span>
        </div>
        <span class="text-xs font-mono text-muted-foreground group-hover:text-primary transition-colors">@hettt &middot; Top 8%</span>
      </a>

      <a href="https://hettt.medium.com/" target="_blank" rel="noopener noreferrer" class="group block border-t border-border py-4">
        <div class="flex items-center gap-2 mb-1">
          <Icon name="medium" class="size-4 text-muted-foreground" />
          <span class="text-sm font-semibold text-foreground">Medium</span>
        </div>
        <span class="text-xs font-mono text-muted-foreground group-hover:text-primary transition-colors">@hettt</span>
      </a>

      <a href="mailto:hello@networkshard.com" class="group block border-t border-border py-4">
        <div class="flex items-center gap-2 mb-1">
          <Icon name="mail" class="size-4 text-muted-foreground" />
          <span class="text-sm font-semibold text-foreground">Email</span>
        </div>
        <span class="text-xs font-mono text-muted-foreground group-hover:text-primary transition-colors">hello@networkshard.com</span>
      </a>
    </div>
  </section>
</BaseLayout>

<script>
  fetch('https://networkshard-views-proxy.awesomehet1.workers.dev')
    .then(r => r.json())
    .then(data => {
      const el = document.getElementById('pageviews');
      if (el) el.textContent = data.count;
    })
    .catch(() => {});
</script>
