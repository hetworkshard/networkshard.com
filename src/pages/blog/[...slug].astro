---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { render } from 'astro:content';
import { getPostSlug, getPublishedPosts } from '../../lib/posts';
import { slugify } from '../../lib/slugify';
import { computeReadTime } from '../../lib/readTime';
import { categoryUrl, getCategoryLabel, isCategoryId, type CategoryId } from '../../lib/taxonomy';
import { articleSchema } from '../../lib/jsonld';
import TableOfContents from '../../components/TableOfContents.astro';
import ReadingProgress from '../../components/ReadingProgress.astro';
import PostNav from '../../components/PostNav.astro';
import RelatedPosts from '../../components/RelatedPosts.astro';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post, i) => {
    const slug = getPostSlug(post);
    // posts are sorted newest-first: "next" = newer, "prev" = older
    const next = posts[i - 1] ?? null;
    const prev = posts[i + 1] ?? null;

    const tags = new Set(post.data.tags || []);
    const related = posts
      .filter((p) => p.id !== post.id)
      .map((p) => ({
        post: p,
        shared: (p.data.tags || []).filter((t) => tags.has(t)).length,
      }))
      .filter((r) => r.shared > 0)
      .sort((a, b) => b.shared - a.shared || b.post.data.date.valueOf() - a.post.data.date.valueOf())
      .slice(0, 3)
      .map((r) => r.post);

    return {
      params: { slug },
      props: { post, prev, next, related },
    };
  });
}

const { post, prev, next, related } = Astro.props;
const slug = getPostSlug(post);
const { Content, headings } = await render(post);
const readTime = computeReadTime(post.body ?? '', post.data.readTime);
const category = isCategoryId(post.data.category) ? post.data.category : 'research' as CategoryId;
const categoryLabel = getCategoryLabel(category);

const ogImage = `${Astro.site}og/${slug}.png`;
const postUrl = `${Astro.site}blog/${slug}/`;
const encodedUrl = encodeURIComponent(postUrl);
const encodedTitle = encodeURIComponent(post.data.title);

const jsonLd = articleSchema({
  headline: post.data.title,
  description: post.data.description,
  image: ogImage,
  datePublished: post.data.date,
  articleSection: categoryLabel,
  url: postUrl,
  tags: post.data.tags,
});
---

<BaseLayout title={post.data.title} description={post.data.description} image={ogImage} ogType="article" jsonLd={jsonLd}>
  <ReadingProgress />
  <article>
    <nav class="mb-6" aria-label="breadcrumb">
      <a href="/blog" class="text-xs font-mono text-muted-foreground hover:text-foreground transition-colors">&larr; Back to blog</a>
    </nav>

    <header class="mb-8 border-b border-border pb-8">
      <p class="mb-3 text-xs uppercase tracking-[0.18em] text-primary">/blog/{slug}</p>
      <h1 class="mb-4 text-3xl font-bold leading-tight tracking-[-0.04em] text-foreground md:text-5xl">
        {post.data.title}
      </h1>
      <div class="flex flex-wrap items-center gap-1.5 text-[11px] font-mono text-muted-foreground mb-4">
        <time datetime={post.data.date.toISOString()}>{post.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</time>
        <span class="text-muted-foreground/50">&middot;</span><span>{readTime}</span>
        <span class="text-muted-foreground/50">&middot;</span>
        <a href={categoryUrl(category)} class="transition-colors hover:text-primary">{categoryLabel}</a>
      </div>
      {post.data.tags && post.data.tags.length > 0 && (
        <div class="flex flex-wrap gap-x-4 gap-y-2 border-t border-border pt-4">
          {post.data.tags.map((tag: string) => (
            <a href={`/blog/tags/${slugify(tag)}`} class="text-xs text-muted-foreground transition-colors hover:text-primary">#{tag}</a>
          ))}
        </div>
      )}
    </header>

    {post.data.cover && (
      <figure class="post-cover mb-8">
        <img src={post.data.cover} alt={post.data.coverAlt ?? ''} loading="eager" decoding="async" />
      </figure>
    )}

    <TableOfContents headings={headings} />

    <div class="prose max-w-none">
      <Content />
    </div>

    <div class="mt-10 pt-6 border-t border-border/40 flex items-center gap-3">
      <span class="text-xs font-mono text-muted-foreground">Share</span>
      <a
        href={`https://x.com/intent/tweet?url=${encodedUrl}&text=${encodedTitle}`}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex size-7 items-center justify-center border-b border-border text-muted-foreground transition-colors hover:border-primary hover:text-foreground"
        aria-label="Share on X"
      >
        <svg class="size-3.5" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
      </a>
      <a
        href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodedUrl}`}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex size-7 items-center justify-center border-b border-border text-muted-foreground transition-colors hover:border-primary hover:text-foreground"
        aria-label="Share on LinkedIn"
      >
        <svg class="size-3.5" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
      </a>
      <button
        id="copy-link-btn"
        class="inline-flex size-7 items-center justify-center border-b border-border text-muted-foreground transition-colors hover:border-primary hover:text-foreground"
        aria-label="Copy link"
        data-url={postUrl}
      >
        <svg class="size-3.5 icon-link" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
        <svg class="size-3.5 icon-check hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
      </button>
    </div>

    <RelatedPosts posts={related} />
    <PostNav prev={prev} next={next} />

    <section class="mt-8 pt-8 border-t border-border/40">
      <h2 class="text-lg font-semibold tracking-tight text-foreground mb-6">Comments</h2>
      <div id="giscus-container" class="min-h-[8rem]">
        <script
          is:inline
          src="https://giscus.app/client.js"
          data-repo="hett-patell/networkshard.com"
          data-repo-id="R_kgDOR1pQQw"
          data-category="Announcements"
          data-category-id="DIC_kwDOR1pQQ84C6FuR"
          data-mapping="pathname"
          data-strict="0"
          data-reactions-enabled="1"
          data-emit-metadata="0"
          data-input-position="top"
          data-theme="preferred_color_scheme"
          data-lang="en"
          data-loading="lazy"
          crossorigin="anonymous"
          async
        ></script>
      </div>
    </section>
  </article>

  <style>
    .post-cover {
      overflow: hidden;
      border: 1px solid var(--border);
      border-radius: var(--radius);
      aspect-ratio: 16 / 9;
    }
    .post-cover img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }
  </style>

  <script>
    function getGiscusTheme() {
      const theme = document.documentElement.getAttribute('data-theme');
      return theme === 'dark' ? 'dark_dimmed' : 'light';
    }

    function setGiscusTheme() {
      const iframe = document.querySelector<HTMLIFrameElement>('iframe.giscus-frame');
      if (!iframe) return;
      iframe.contentWindow?.postMessage(
        { giscus: { setConfig: { theme: getGiscusTheme() } } },
        'https://giscus.app'
      );
    }

    // Sync giscus theme when site theme toggles
    const observer = new MutationObserver((mutations) => {
      for (const mutation of mutations) {
        if (mutation.attributeName === 'data-theme') {
          setGiscusTheme();
        }
      }
    });
    observer.observe(document.documentElement, { attributes: true });

    // Set initial theme once giscus loads
    window.addEventListener('message', (event) => {
      if (event.origin !== 'https://giscus.app') return;
      setGiscusTheme();
    });
  </script>

  <script>
    const btn = document.getElementById('copy-link-btn');
    btn?.addEventListener('click', () => {
      const url = btn.getAttribute('data-url') || window.location.href;
      navigator.clipboard.writeText(url).then(() => {
        btn.querySelector('.icon-link')?.classList.add('hidden');
        btn.querySelector('.icon-check')?.classList.remove('hidden');
        btn.classList.add('text-primary');
        setTimeout(() => {
          btn.querySelector('.icon-link')?.classList.remove('hidden');
          btn.querySelector('.icon-check')?.classList.add('hidden');
          btn.classList.remove('text-primary');
        }, 2000);
      });
    });
  </script>
</BaseLayout>
